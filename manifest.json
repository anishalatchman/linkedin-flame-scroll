{
  "manifest_version": 3,
  "name": "LinkedIn Flames Scroller",
  "version": "1.1.0",
  "description": "Cartoon animated flames rise as you scroll LinkedIn. Reach 10 posts and an inferno prompts you to post or leave!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "http://*.linkedin.com/*"
      ],
      "all_frames": false,
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
