{
  "manifest_version": 3,
  "name": "LinkedIn Doomscroll Inferno 🔥",
  "version": "1.0.0",
  "description": "Cartoon animated flames rise as you scroll LinkedIn. Reach 10 posts and an inferno consumes the screen to break your doomscroll!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinkedIn Doomscroll Inferno Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "http://*.linkedin.com/*",
        "*://*/*demo.html*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "exit.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
